# PlotFinder Chennai — Firebase Web Client Configuration Example
# Duplicate this file as .env.local and populate with your Firebase Web App credentials.
# Do NOT commit .env.local or serviceAccountKey.json to source control.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=plotfinder-be7f5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=plotfinder-be7f5
VITE_FIREBASE_STORAGE_BUCKET=plotfinder-be7f5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
