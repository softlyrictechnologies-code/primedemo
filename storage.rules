rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'super-admin' ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }
    function isEditor() {
      return request.auth != null && request.auth.token.role == 'editor';
    }
    function isImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Admin: property listing images (add, change, delete)
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isEditor()) && isImage();
      allow delete: if isAdmin();
    }

    // Public site branding assets are readable on the website and writable by admins.
    match /siteAssets/branding/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isEditor()) && isImage();
      allow delete: if isAdmin();
    }

    // Public sellers/landowners: upload photos with a submission, admin reviews them
    match /landowner_submissions/{allPaths=**} {
      allow get: if true;
      allow create: if isImage();
      allow list: if false;
      allow update, delete: if isAdmin();
    }
    match /sellerSubmissions/{allPaths=**} {
      allow get: if true;
      allow create: if isImage();
      allow list: if false;
      allow update, delete: if isAdmin();
    }
    match /submissions/{allPaths=**} {
      allow get: if true;
      allow create: if isImage();
      allow list: if false;
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
