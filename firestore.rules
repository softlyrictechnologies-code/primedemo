rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'super-admin'
      );
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'super-admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isEditor() {
      return isSignedIn() && request.auth.token.role == 'editor';
    }
    function isSupport() {
      return isSignedIn() && request.auth.token.role == 'support';
    }
    function canManageListings() { return isAdmin() || isEditor(); }
    function canManageLeads() { return isAdmin() || isSupport(); }
    function canReadAdminData() { return isAdmin() || isEditor() || isSupport(); }
    function hasValidPropertyTitle(data) {
      return data.title is string
        && data.title.size() >= 12
        && data.title.size() <= 100
        && data.title.matches('.*[A-Za-z].*')
        && data.title.matches('.* .*');
    }
    function isPublishableProperty(data) {
      return data.published == true
        && data.verified == true
        && hasValidPropertyTitle(data)
        && data.location is string
        && data.location.size() > 0
        && data.areaSqFt is number
        && data.areaSqFt > 0
        && data.price is number
        && data.price > 0
        && data.images is list
        && data.images.size() > 0
        && data.approval is string
        && data.approval.matches('.*([Aa]pproved|[Vv]erified|[Rr]egistered).*');
    }
    function hasValidPropertyStatus(data) {
      return data.status in ['draft', 'published', 'sold_out']
        && (data.status != 'published' || (data.published == true && data.isSoldOut == false))
        && (data.status != 'draft' || (data.published == false && data.isSoldOut == false))
        && (data.status != 'sold_out' || (data.published == true && data.isSoldOut == true && data.soldOutAt != null));
    }
    function hasValidLandownerSubmission(data) {
      return data.status == 'pending'
        && data.reviewStatus == 'pending'
        && data.consentToContact == true
        && data.title is string
        && data.title.size() >= 12
        && data.title.size() <= 100
        && data.title.matches('.* .*')
        && data.sellerName is string
        && data.sellerName.size() > 0
        && data.sellerName.size() <= 100
        && data.sellerPhone is string
        && data.sellerPhone.matches('^[6-9][0-9]{9}$')
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 160
        && data.areaSqFt is number
        && data.areaSqFt > 0
        && data.expectedPrice is number
        && data.expectedPrice > 0
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2500
        && data.images is list
        && data.images.size() <= 6;
    }
    function hasValidBuyerEnquiry(data) {
      return data.status == 'new'
        && !data.keys().hasAny(['preferredDate', 'preferredTime', 'visitDate', 'visitTime'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.matches('^(91)?[6-9][0-9]{9}$')
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyId.size() <= 160
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 1000
        && (!('address' in data)
          || data.address == null
          || (data.address is string && data.address.size() <= 300));
    }
    function hasValidContactMessage(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() > 0
        && data.email.matches('^.+@.+\\..+$')
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 2000;
    }

    // Public listing: only published properties are visible
    match /properties/{id} {
      allow read: if resource.data.published == true || canReadAdminData();
      allow create: if canManageListings() && hasValidPropertyStatus(request.resource.data) && (
        (request.resource.data.published != true && hasValidPropertyTitle(request.resource.data))
        || isPublishableProperty(request.resource.data)
      );
      allow update: if canManageListings() && hasValidPropertyStatus(request.resource.data) && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title'])
          || hasValidPropertyTitle(request.resource.data))
        && (request.resource.data.published != true
          || resource.data.published == true
          || isPublishableProperty(request.resource.data))
      );
      allow delete: if canManageListings();
    }

    // Landowner submissions: anyone can submit pending, only admin reviews
    match /landowner_submissions/{id} {
      allow create: if hasValidLandownerSubmission(request.resource.data);
      allow read: if canManageLeads();
      allow update, delete: if canManageLeads();
    }
    match /sellerSubmissions/{id} {
      allow create: if hasValidLandownerSubmission(request.resource.data);
      allow read, update, delete: if canManageLeads();
    }

    // Buyer enquiries and contact form
    match /buyer_enquiries/{id} {
      allow create: if hasValidBuyerEnquiry(request.resource.data);
      allow read, update, delete: if canManageLeads();
    }
    match /inquiries/{id} {
      allow create: if hasValidBuyerEnquiry(request.resource.data);
      allow read: if canManageLeads() || isAdmin();
      allow delete: if canManageLeads();
      allow update: if canManageLeads()
        && request.resource.data.status in ['new', 'contacted', 'closed']
        && !request.resource.data.keys().hasAny(['preferredDate', 'preferredTime', 'visitDate', 'visitTime']);
    }
    match /contactMessages/{id} {
      allow create: if hasValidContactMessage(request.resource.data);
      allow read: if canManageLeads() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Public content & CMS
    match /locations/{id} {
      allow read: if resource.data.active == true || canReadAdminData();
      allow write: if canManageListings();
    }
    match /insights/{id} {
      allow read: if resource.data.published == true || canReadAdminData();
      allow write: if canManageListings();
    }
    match /settings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow create: if id == 'site' && canManageListings() && request.resource.data.keys().hasOnly([
        'companyName', 'logoUrl', 'tagline', 'primaryColor', 'phone', 'workingHours',
        'trustLine', 'trustBadge', 'badgeText', 'contactPhone', 'hours', 'updatedAt'
      ]);
      allow update: if id == 'site' && canManageListings() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'companyName', 'logoUrl', 'tagline', 'primaryColor', 'phone', 'workingHours',
        'trustLine', 'trustBadge', 'badgeText', 'contactPhone', 'hours', 'updatedAt'
      ]);
    }
    match /website_content/{id} {
      allow read: if true;
      allow write: if canManageListings();
    }
    match /websiteContent/{id} {
      allow read: if true;
      allow write: if canManageListings();
    }

    // Admin audit trail
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // A user can read and edit their own profile, but never the role unless admin
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
                    && !('role' in request.resource.data);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid && !('role' in request.resource.data.diff(resource.data).affectedKeys()))
      );
      allow delete: if isAdmin();
    }

    // A user can only touch their own favorites
    match /favorites/{id} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Admin registry: written only by the Admin SDK
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Default deny all other unspecified collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
